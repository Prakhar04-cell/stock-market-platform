# TradeX Monorepo .gitignore

# Environment variables & secrets
.env
.env.*
.env.local
.env.production
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*.local
!.env.example
!backend/.env.example
*.pem
*.key
*.cert
credentials.json

# Python
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
coverage/
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Databases & Cache
*.sqlite
*.sqlite3
*.db
dump.rdb

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker
.docker/
