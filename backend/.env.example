# ==============================================================================
# TradeX Backend - Production & Development Environment Template
# ==============================================================================
# NEVER commit .env to version control.
# NEVER expose DATABASE_URL, REDIS_URL, JWT_SECRET, or UPSTOX secrets to the browser.
# ==============================================================================

# Application Runtime
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="TradeX Trading Platform"
VERSION=1.0.0

# Server Binding
# Hosting providers (Render, Railway, Cloud Run, etc.) inject the PORT variable automatically.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000

# Frontend Integration & CORS
# Set FRONTEND_URL to your production Vercel domain (e.g. https://your-tradex.vercel.app)
FRONTEND_URL=https://your-tradex.vercel.app
# Comma-separated list of allowed origins. FRONTEND_URL is automatically included.
CORS_ORIGINS=https://your-tradex.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
# In production, use your Neon pooled connection string.
# Note: Neon strings with sslmode=require are automatically converted to ssl=require for asyncpg.
DATABASE_URL=postgresql+asyncpg://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?ssl=require
# Sync connection URL used by Alembic migrations:
SYNC_DATABASE_URL=postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require

# ==============================================================================
# Cache & WebSocket State (Upstash Redis)
# ==============================================================================
# For Upstash Redis, use the rediss:// (TLS) connection string:
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_TOKEN=

# ==============================================================================
# JWT Authentication
# ==============================================================================
# Generate a cryptographically secure 32+ character key:
# openssl rand -hex 32
JWT_SECRET=generate_a_random_32_byte_hex_string_for_production_security
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# Upstox API Configuration (Real Market Data V2/V3)
# ==============================================================================
# Upstox Developer Portal: https://developer.upstox.com/
# Configure UPSTOX_ACCESS_TOKEN on the backend server only.
# DO NOT put UPSTOX_ACCESS_TOKEN into Vercel frontend environment variables.
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://your-backend-api.onrender.com/api/v1/upstox/auth/callback
UPSTOX_INTEGRATION_TEST=false

# ==============================================================================
# Paper Trading Engine Settings
# ==============================================================================
INITIAL_PAPER_BALANCE=100000.00
DEFAULT_CURRENCY=INR

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_MAX_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# Sentry Error Reporting (Optional)
SENTRY_DSN=

# ==============================================================================
# External Market Data API (Fallback Provider)
# ==============================================================================
# Server-side only — NEVER use NEXT_PUBLIC_ prefix.
# Provider will be configured after API key is obtained.
MARKET_DATA_API_KEY=
MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_PROVIDER=
