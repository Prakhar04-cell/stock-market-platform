# ==============================================================================
# TradeX Platform - Environment Configuration Example
# Copy this file to .env and configure values before starting services
# NEVER commit .env to version control
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TradeX Trading Platform"

# Backend URLs & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Neon)
# Async connection (FastAPI SQLAlchemy 2.0 AsyncEngine)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradex
# Sync connection (Alembic Migrations)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradex

# Redis Configuration (Local Redis or Upstash)
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN=

# JWT Authentication
# Generated using: openssl rand -hex 32
JWT_SECRET=tradex_super_secret_jwt_key_must_be_changed_in_production_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Paper Trading Settings
INITIAL_PAPER_BALANCE=100000.00
DEFAULT_CURRENCY=INR

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_MAX_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# Sentry Configuration (Phase 2 - Placeholder only)
# Sentry DSN will be connected after repository and CI/CD setup
SENTRY_DSN=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="TradeX"
NEXT_PUBLIC_APP_ENV="development"
