# ==============================================================================
# TradeX Platform - Environment Configuration Example
# Copy this file to .env and configure values before starting services
# NEVER commit .env to version control
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TradeX Trading Platform"

# Backend URLs & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Java Security & Trading Analytics Microservice
# Local: http://localhost:8081 | Docker: http://java-service:8081 | Production: https://your-bullrun-java-service.onrender.com
JAVA_SERVICE_URL=http://localhost:8081

# Database Configuration (PostgreSQL / Neon)
# Async connection (FastAPI SQLAlchemy 2.0 AsyncEngine)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradex
# Sync connection (Alembic Migrations)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradex

# Redis Configuration (Local Redis or Upstash)
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN=your_redis_token_here

# JWT Authentication
# Generated using: openssl rand -hex 32
JWT_SECRET=tradex_super_secret_jwt_key_must_be_changed_in_production_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Paper Trading Settings
INITIAL_PAPER_BALANCE=100000.00
DEFAULT_CURRENCY=INR

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_MAX_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# Sentry Configuration (Phase 2 - Placeholder only)
# Sentry DSN will be connected after repository and CI/CD setup
SENTRY_DSN=https://2b19b2de1a5e8140c81da5910b7bb35e@o4512100901126144.ingest.us.sentry.io/4512124124004352

# Upstox API Configuration (Phase 2 - Real Market Data)
# Upstox Developer Console: https://developer.upstox.com/
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/upstox/auth/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_INTEGRATION_TEST=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="TradeX"
NEXT_PUBLIC_APP_ENV="development"

# External Market Data API (Fallback Provider)
# Server-side only — NEVER use NEXT_PUBLIC_ prefix.
MARKET_DATA_API_KEY=
MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_PROVIDER=

# Marketaux Financial News API (Optional Provider)
# Server-side only — NEVER expose to frontend. Configure on Render backend only.
MARKETAUX_API_TOKEN=

